<?xml version="1.0" encoding="utf-8"?>
<!--
  Clock & Weather widget (both versions). Filled in by ClockWidgetView.kt.

  [ painted sky (hidden in the transparent version) ]
   10:42                         [icon] 28°
   Sat, 7 Nov              Sunny · H 31° L 19°
                                      Karachi

  Text sits at the bottom so the sky's sun / clouds (top right) stay visible.
  Only views Android allows in widgets: FrameLayout, LinearLayout,
  ImageView, TextView, TextClock.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Bitmap drawn at the widget's own aspect ratio (rounded corners are in the picture) -->
    <ImageView
        android:id="@+id/widget_sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingLeft="18dp"
        android:paddingTop="12dp"
        android:paddingRight="18dp"
        android:paddingBottom="14dp">

        <!-- Left: the clock. TextClock follows the phone's 12/24-hour setting. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/widget_time"
                style="@style/WidgetClock.Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm" />

            <TextClock
                android:id="@+id/widget_date"
                style="@style/WidgetClock.Date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE, d MMM"
                android:format24Hour="EEE, d MMM" />
        </LinearLayout>

        <!-- Right: the weather -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Only in the transparent version (44dp: keep in sync with ART_DP) -->
                <ImageView
                    android:id="@+id/widget_art"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginRight="6dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_temp"
                    style="@style/WidgetClock.Temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_label"
                style="@style/WidgetClock.Detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/widget_city"
                style="@style/WidgetClock.Detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
